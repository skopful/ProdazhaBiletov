<Window x:Class="ProdazhaBiletov.MeropriyatieEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Мероприятие" Height="800" Width="850" MinHeight="700" MinWidth="780" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PageBrush}"
        FontFamily="{StaticResource BaseFont}" FontSize="14">
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="tbTitle" Text="Новое мероприятие" Style="{StaticResource PageTitle}" Margin="0,0,0,12"/>

                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Основные сведения" Style="{StaticResource BlockTitle}" Margin="0,0,0,12"/>

                        <TextBlock Text="Название *" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="tbNazvanie" Style="{StaticResource FieldBox}" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Тип *" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cbTip" Style="{StaticResource DropDown}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Зал *" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cbZal" Style="{StaticResource DropDown}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Дата *" Style="{StaticResource FieldLabel}"/>
                                <DatePicker x:Name="dpData" Style="{StaticResource DateField}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Время *" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="tbVremya" Style="{StaticResource FieldBox}" Text="19:00"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Продолжительность, мин *" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="tbProdolzhitelnost" Style="{StaticResource FieldBox}" Text="120"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Возрастное ограничение *" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="tbVozrast" Style="{StaticResource FieldBox}" Text="12"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Число мест (подставляется из справочника залов)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="tbVmestimost" Style="{StaticResource FieldBox}" IsEnabled="False" Margin="0,0,0,10"/>

                        <TextBlock Text="Описание" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="tbOpisanie" Style="{StaticResource FieldBox}" Height="90" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>

                        <TextBlock Text="Афиша (ссылка на изображение)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="tbAfisha" Style="{StaticResource FieldBox}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Категории мест и цены" Style="{StaticResource BlockTitle}"/>
                            <Button Content="+ Добавить категорию" Style="{StaticResource GhostButton}" Width="170"
                                    HorizontalAlignment="Right" Click="btnAddCategory_Click"/>
                        </Grid>
                        <DataGrid x:Name="dgCeny" Height="180" Style="{StaticResource DataTableStyle}"
                                  CanUserAddRows="False" IsReadOnly="False" ColumnHeaderStyle="{StaticResource TableHeaderStyle}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Категория" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox x:Name="cbKat" Style="{StaticResource DropDown}" Height="30"
                                                      DisplayMemberPath="Name" SelectedValuePath="Id"
                                                      ItemsSource="{Binding Kategorii, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedValue="{Binding IdKategorii, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Цена, руб." Binding="{Binding Cena, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="140" ElementStyle="{StaticResource MonoText}"/>
                                <DataGridTemplateColumn Header="" Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✕" Style="{StaticResource LinkButton}" Tag="{Binding}"
                                                    Click="btnDelCategory_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Публикация" Style="{StaticResource BlockTitle}" Margin="0,0,0,12"/>
                        <TextBlock Text="Статус публикации *" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="cbStatus" Style="{StaticResource DropDown}" Width="240" HorizontalAlignment="Left" Margin="0,0,0,4">
                            <ComboBoxItem Content="Черновик"/>
                            <ComboBoxItem Content="Опубликовано"/>
                            <ComboBoxItem Content="Архив"/>
                        </ComboBox>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="btnSave" Content="Сохранить" Style="{StaticResource AccentButton}" Width="150" Click="btnSave_Click"/>
            <Button Content="Отмена" Style="{StaticResource GhostButton}" Width="120" Margin="10,0,0,0" Click="btnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>