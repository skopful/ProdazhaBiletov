<UserControl x:Class="ProdazhaBiletov.AdminZakazyPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20,16,20,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Заказы" Style="{StaticResource PageTitle}"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="tbSearch" Style="{StaticResource FieldBox}" Width="240" Margin="0,0,12,0"
                         ToolTip="Поиск по номеру заказа или покупателю" TextChanged="tbSearch_TextChanged"/>
                <ComboBox x:Name="cbStatus" Style="{StaticResource DropDown}" Width="180" Margin="0,0,12,0" SelectionChanged="FilterChanged"/>
                <DatePicker x:Name="dpFrom" Style="{StaticResource DateField}" Width="150" SelectedDateChanged="FilterChanged"/>
                <TextBlock Text="–" Margin="8,0" VerticalAlignment="Center"/>
                <DatePicker x:Name="dpTo" Style="{StaticResource DateField}" Width="150" SelectedDateChanged="FilterChanged"/>
            </StackPanel>
        </Border>

        <DataGrid x:Name="dgOrders" Grid.Row="2" Style="{StaticResource DataTableStyle}" ColumnHeaderStyle="{StaticResource TableHeaderStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Номер" Binding="{Binding NomerZakaza}" Width="120" ElementStyle="{StaticResource MonoText}"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding DataZakaza, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="145"
                                    ElementStyle="{StaticResource MonoText}"/>
                <DataGridTextColumn Header="Покупатель" Binding="{Binding Polzovatel}" Width="1.5*"/>
                <DataGridTextColumn Header="Мероприятие" Binding="{Binding Meropriyatie}" Width="2*"/>
                <DataGridTextColumn Header="Билетов" Binding="{Binding Kolichestvo}" Width="80"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding SummaZakaza, StringFormat={}{0:N0} ₽}" Width="110"
                                    ElementStyle="{StaticResource MonoText}"/>
                <DataGridTextColumn Header="Оплата" Binding="{Binding SposobOplaty}" Width="110"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding StatusZakaza}" Width="120"/>
                <DataGridTemplateColumn Header="Действия" Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Оплачено" Style="{StaticResource LinkButton}" Tag="{Binding}" Click="btnMarkPaid_Click"/>
                                <Button Content="Отмена" Style="{StaticResource LinkButton}" Foreground="{StaticResource ErrorBrush}"
                                        Tag="{Binding}" Click="btnCancel_Click"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>