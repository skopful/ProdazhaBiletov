<Window x:Class="ProdazhaBiletov.EventDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Мероприятие" Height="860" Width="1400" MinHeight="680" MinWidth="1150"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Loaded="Window_Loaded"
        Background="{StaticResource PageBrush}" FontFamily="{StaticResource BaseFont}">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="130" Height="170" CornerRadius="4"
                            Background="{StaticResource MainBrush}" x:Name="bdAfisha">
                        <TextBlock Text="АФИША" Foreground="#8FA0D0" FontSize="12" FontFamily="{StaticResource MonoFont}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="18,0,0,0">
                        <TextBlock x:Name="tbTip" Style="{StaticResource CaptionText}"/>
                        <TextBlock x:Name="tbNazvanie" Style="{StaticResource PageTitle}" TextWrapping="Wrap" Margin="0,2,0,8"/>

                        <TextBlock x:Name="tbInfo" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border x:Name="bdSvobodno" Style="{StaticResource StatusBadge}" Background="{StaticResource SuccessBrush}">
                                <TextBlock x:Name="tbSvobodno" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                            <Border Style="{StaticResource StatusBadge}" Background="{StaticResource LightFillBrush}" Margin="8,0,0,0">
                                <TextBlock x:Name="tbZanyatost" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                            </Border>
                        </StackPanel>

                        <TextBlock x:Name="tbOpisanie" Style="{StaticResource BodyText}" TextWrapping="Wrap" MaxHeight="70"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl x:Name="seatMap" Grid.Row="1"/>
        </Grid>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Ваши места" Style="{StaticResource BlockTitle}"/>
                    <TextBlock x:Name="tbPodskazka" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Нажмите на свободное место в схеме, чтобы выбрать его."/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <DataGrid x:Name="dgSelected" Style="{StaticResource DataTableStyle}"
                                  ColumnHeaderStyle="{StaticResource TableHeaderStyle}" RowHeight="34">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Место" Binding="{Binding Adres}" Width="*"/>
                                <DataGridTextColumn Header="Категория" Binding="{Binding Kategoriya}" Width="110"/>
                                <DataGridTextColumn Header="Цена" Width="90" ElementStyle="{StaticResource MonoText}"
                                                    Binding="{Binding Cena, StringFormat={}{0:N0}}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </ScrollViewer>

                    <TextBlock x:Name="tbNet" Grid.Row="1" Text="Места не выбраны"
                               Style="{StaticResource CaptionText}" HorizontalAlignment="Center" Margin="0,20,0,20"
                               Visibility="Collapsed"/>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Итого" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="tbTotal" Text="0 ₽" HorizontalAlignment="Right" FontSize="22" FontWeight="Bold"
                                   FontFamily="{StaticResource HeadFont}" Foreground="{StaticResource MainBrush}"/>
                    </Grid>

                    <Button x:Name="btnBuy" Content="Купить билеты" Style="{StaticResource AccentButton}"
                            Click="btnBuy_Click" Margin="0,0,0,8"/>
                    <Button x:Name="btnBook" Content="Забронировать" Style="{StaticResource MainButton}"
                            Click="btnBook_Click" Margin="0,0,0,8"/>

                    <Border Style="{StaticResource Card}" Background="{StaticResource PageBrush}" Padding="10">
                        <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                   Text="Бронь действует 30 минут. Неоплаченная бронь снимается автоматически."/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>