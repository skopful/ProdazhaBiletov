<UserControl x:Class="ProdazhaBiletov.AdminOtchetPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20,16,20,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Отчёты" Style="{StaticResource PageTitle}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="Мероприятие:" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="cbMer" Style="{StaticResource DropDown}" Width="380" SelectionChanged="cbMer_SelectionChanged"/>
                <Button Content="Печать" Style="{StaticResource GhostButton}" Width="110" Margin="10,0,0,0" Click="btnPrint_Click"/>
                <Button Content="Выгрузить" Style="{StaticResource GhostButton}" Width="120" Margin="10,0,0,0" Click="btnExport_Click"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
            <StackPanel>

                <UniformGrid Columns="4" Margin="0,0,0,10">
                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Продано билетов" Style="{StaticResource CaptionText}"/>
                            <TextBlock x:Name="tbProdano" Text="0" FontSize="24" FontWeight="Bold"
                                       FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource SuccessBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Забронировано" Style="{StaticResource CaptionText}"/>
                            <TextBlock x:Name="tbBron" Text="0" FontSize="24" FontWeight="Bold"
                                       FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource WarningBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Занятость зала" Style="{StaticResource CaptionText}"/>
                            <TextBlock x:Name="tbZanyatost" Text="0%" FontSize="24" FontWeight="Bold"
                                       FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource MainBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Выручка" Style="{StaticResource CaptionText}"/>
                            <TextBlock x:Name="tbVyrushka" Text="0 ₽" FontSize="24" FontWeight="Bold"
                                       FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource AccentBrush}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Продажи по дням" Style="{StaticResource BlockTitle}" Margin="0,0,0,12"/>
                            <ItemsControl x:Name="panelGrafik" Height="180">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Den}" Style="{StaticResource MonoText}"
                                                       VerticalAlignment="Center" FontSize="12"/>
                                            <Grid Grid.Column="1" Height="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding FillWidth}"/>
                                                    <ColumnDefinition Width="{Binding RestWidth}"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="{StaticResource AccentBrush}" CornerRadius="2"/>
                                                <Border Grid.Column="1" Background="{StaticResource LightFillBrush}" CornerRadius="2"/>
                                            </Grid>
                                            <TextBlock Grid.Column="2" Text="{Binding Kolichestvo}" Style="{StaticResource MonoText}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="По категориям мест" Style="{StaticResource BlockTitle}" Margin="0,0,0,12"/>
                            <DataGrid x:Name="dgKategorii" Style="{StaticResource DataTableStyle}" ColumnHeaderStyle="{StaticResource TableHeaderStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Категория" Binding="{Binding NazvanieKategorii}" Width="*"/>
                                    <DataGridTextColumn Header="Прод." Binding="{Binding Prodano}" Width="70"/>
                                    <DataGridTextColumn Header="Выручка" Binding="{Binding Summa, StringFormat={}{0:N0} ₽}" Width="110"
                                                        ElementStyle="{StaticResource MonoText}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <DataGrid x:Name="dgOtchet" Grid.Row="2" Style="{StaticResource DataTableStyle}" ColumnHeaderStyle="{StaticResource TableHeaderStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" Binding="{Binding DataVremyaNachala, StringFormat={}{0:dd.MM.yyyy}}"
                                    Width="110" ElementStyle="{StaticResource MonoText}"/>
                <DataGridTextColumn Header="Мероприятие" Binding="{Binding Nazvanie}" Width="2*"/>
                <DataGridTextColumn Header="Зал" Binding="{Binding NazvanieZala}" Width="160"/>
                <DataGridTextColumn Header="Вместимость" Binding="{Binding Vmestimost}" Width="110" ElementStyle="{StaticResource MonoText}"/>
                <DataGridTextColumn Header="Продано" Binding="{Binding Prodano}" Width="100"/>
                <DataGridTextColumn Header="Занятость" Binding="{Binding Zanyatost, StringFormat={}{0:N1} %}" Width="110"/>
                <DataGridTextColumn Header="Выручка" Binding="{Binding Vyrushka, StringFormat={}{0:N0} ₽}" Width="130"
                                    ElementStyle="{StaticResource MonoText}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>