<UserControl x:Class="ProdazhaBiletov.MoiZakazyPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20,16,20,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Мои заказы" Style="{StaticResource PageTitle}"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Статус:" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="4,0,8,0"/>
                <ComboBox x:Name="cbStatus" Style="{StaticResource DropDown}" Width="180" SelectionChanged="FilterChanged"/>
                <TextBlock Text="Период с:" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="16,0,8,0"/>
                <DatePicker x:Name="dpFromZ" Style="{StaticResource DateField}" Width="150" SelectedDateChanged="FilterChanged"/>
                <TextBlock Text="по:" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="8,0,8,0"/>
                <DatePicker x:Name="dpToZ" Style="{StaticResource DateField}" Width="150" SelectedDateChanged="FilterChanged"/>
                <Button Content="Сбросить" Style="{StaticResource GhostButton}" Margin="16,0,0,0" Click="btnResetZ_Click"/>
            </StackPanel>
        </Border>

        <DataGrid x:Name="dgZakazy" Grid.Row="2" Style="{StaticResource DataTableStyle}" ColumnHeaderStyle="{StaticResource TableHeaderStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Номер заказа" Binding="{Binding NomerZakaza}" Width="130" ElementStyle="{StaticResource MonoText}"/>
                <DataGridTextColumn Header="Дата заказа" Binding="{Binding DataZakaza, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="150"
                                    ElementStyle="{StaticResource MonoText}"/>
                <DataGridTextColumn Header="Статус" Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding StatusZakaza}"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Padding" Value="6,3"/>
                            <Setter Property="HorizontalAlignment" Value="Left"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Background" Value="#7B7F8C"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusZakaza}" Value="Оплачен">
                                    <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusZakaza}" Value="Забронирован">
                                    <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusZakaza}" Value="Отменен">
                                    <Setter Property="Background" Value="{StaticResource ErrorBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusZakaza}" Value="Использован">
                                    <Setter Property="Background" Value="{StaticResource MainBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Сумма" Binding="{Binding SummaZakaza, StringFormat={}{0:N0} ₽}" Width="100"
                                    ElementStyle="{StaticResource MonoText}"/>
                <DataGridTextColumn Header="Мероприятие" Binding="{Binding NazvanieMeropriyatiya}" Width="2*"/>
                <DataGridTextColumn Header="Дата мероприятия" Binding="{Binding DataVremyaNachala, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                    Width="150" ElementStyle="{StaticResource MonoText}"/>
                <DataGridTextColumn Header="Билетов" Binding="{Binding Kolichestvo}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>