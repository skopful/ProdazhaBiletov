<Window x:Class="ProdazhaBiletov.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход" Height="560" Width="560" MinHeight="500" MinWidth="520" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PageBrush}"
        FontFamily="{StaticResource BaseFont}" FontSize="14">
    <Border Style="{StaticResource Card}" Width="400" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
            <TextBlock Text="Продажа билетов" Style="{StaticResource PageTitle}" HorizontalAlignment="Center"/>
            <TextBlock Text="Вход в систему" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" Margin="0,2,0,20"/>

            <TextBlock Text="Электронная почта *" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="tbEmail" Style="{StaticResource FieldBox}" Margin="0,0,0,12"/>

            <TextBlock Text="Пароль *" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="pbPassword" Style="{StaticResource FieldBoxPass}" Margin="0,0,0,12"/>

            <TextBlock x:Name="tbError" Style="{StaticResource ErrorText}" Margin="0,0,0,4"/>

            <Button x:Name="btnLogin" Content="Войти" Style="{StaticResource MainButton}" IsDefault="True" Click="btnLogin_Click"/>

            <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" FontSize="13" Foreground="{StaticResource MutedBrush}">
                <Run Text="Нет аккаунта?"/>
                <Hyperlink Foreground="{StaticResource MainBrush}" Click="Register_Click">Зарегистрироваться</Hyperlink>
            </TextBlock>
        </StackPanel>
    </Border>
</Window>