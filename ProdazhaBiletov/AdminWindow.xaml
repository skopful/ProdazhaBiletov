<Window x:Class="ProdazhaBiletov.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Панель администратора" Height="820" Width="1600" MinHeight="720" MinWidth="1450"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PageBrush}"
        FontFamily="{StaticResource BaseFont}" FontSize="14">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource MainBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,18,0,0">
                    <TextBlock Text="Администратор" Margin="18,0,0,4" FontFamily="{StaticResource HeadFont}"
                               FontSize="17" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="tbAdminUser" Margin="18,0,0,18" FontSize="12" Foreground="#A9B4D4"/>
                </StackPanel>

                <TextBlock DockPanel.Dock="Top" Text="СПРАВОЧНИКИ" Margin="18,0,0,4"
                           FontSize="11" FontWeight="SemiBold" Foreground="#8C99BF"/>
                <StackPanel DockPanel.Dock="Top">
                    <RadioButton x:Name="navMeropriyatiya" GroupName="AdminNav" Content="Мероприятия" Style="{StaticResource MenuItemStyle}"
                                 IsChecked="True" Checked="navMeropriyatiya_Checked"/>
                    <RadioButton x:Name="navZaly" GroupName="AdminNav" Content="Залы и места" Style="{StaticResource MenuItemStyle}"
                                 Checked="navZaly_Checked"/>
                    <RadioButton x:Name="navPolzovateli" GroupName="AdminNav" Content="Пользователи" Style="{StaticResource MenuItemStyle}"
                                 Checked="navPolzovateli_Checked"/>
                </StackPanel>

                <TextBlock DockPanel.Dock="Top" Text="ПРОДАЖИ" Margin="18,18,0,4"
                           FontSize="11" FontWeight="SemiBold" Foreground="#8C99BF"/>
                <StackPanel DockPanel.Dock="Top">
                    <RadioButton x:Name="navZakazy" GroupName="AdminNav" Content="Заказы" Style="{StaticResource MenuItemStyle}"
                                 Checked="navZakazy_Checked"/>
                    <RadioButton x:Name="navOtchet" GroupName="AdminNav" Content="Отчёты" Style="{StaticResource MenuItemStyle}"
                                 Checked="navOtchet_Checked"/>
                </StackPanel>

                <Button DockPanel.Dock="Bottom" Content="Выйти" Style="{StaticResource LinkButton}" Foreground="White"
                        Margin="8,0,8,14" Click="btnExitAdmin_Click"/>
            </DockPanel>
        </Border>

        <ContentControl x:Name="adminHost" Grid.Column="1"/>
    </Grid>
</Window>