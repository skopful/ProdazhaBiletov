<UserControl x:Class="ProdazhaBiletov.AdminPolzovateliPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20,16,20,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Пользователи" Style="{StaticResource PageTitle}"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="tbSearch" Style="{StaticResource FieldBox}" Width="240" Margin="0,0,12,0"
                         TextChanged="tbSearch_TextChanged"/>
                <ComboBox x:Name="cbRol" Style="{StaticResource DropDown}" Width="160" Margin="0,0,12,0" SelectionChanged="FilterChanged"/>
                <ComboBox x:Name="cbState" Style="{StaticResource DropDown}" Width="160" Margin="0,0,12,0" SelectionChanged="FilterChanged"/>
            </StackPanel>
        </Border>

        <DataGrid x:Name="dgUsers" Grid.Row="2" Style="{StaticResource DataTableStyle}" ColumnHeaderStyle="{StaticResource TableHeaderStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding idPolzovatelya}" Width="45" ElementStyle="{StaticResource MonoText}"/>
                <DataGridTextColumn Header="Фамилия" Binding="{Binding Familiya}" Width="*"/>
                <DataGridTextColumn Header="Имя" Binding="{Binding Imya}" Width="*"/>
                <DataGridTextColumn Header="Отчество" Binding="{Binding Otchestvo}" Width="*"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding Telefon}" Width="130" ElementStyle="{StaticResource MonoText}"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="1.5*"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding NazvanieRoli}" Width="130"/>
                <DataGridTextColumn Header="Регистрация" Binding="{Binding DataRegistracii, StringFormat={}{0:dd.MM.yyyy}}" Width="110"/>
                <DataGridTextColumn Header="Заказов" Binding="{Binding KolZakazov}" Width="85"/>
                <DataGridTemplateColumn Header="Состояние" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border x:Name="bd" CornerRadius="3" Padding="8,3" HorizontalAlignment="Left">
                                <TextBlock x:Name="tb" FontSize="12" Foreground="White"/>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Zablokirovan}" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource ErrorBrush}"/>
                                    <Setter TargetName="tb" Property="Text" Value="Заблокирован"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Zablokirovan}" Value="False">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource SuccessBrush}"/>
                                    <Setter TargetName="tb" Property="Text" Value="Активен"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Действия" Width="220">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Роль" Style="{StaticResource LinkButton}" Tag="{Binding}" Click="btnRole_Click"/>
                                <Button Content="Блок." Style="{StaticResource LinkButton}" Foreground="{StaticResource ErrorBrush}"
                                        Tag="{Binding}" Click="btnBlock_Click"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>