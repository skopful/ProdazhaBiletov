<Window x:Class="ProdazhaBiletov.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Продажа билетов" Height="820" Width="1400" MinHeight="700" MinWidth="1200"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PageBrush}"
        FontFamily="{StaticResource BaseFont}" FontSize="14" Language="ru-RU">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource MainBrush}">
            <Grid Height="56">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Продажа билетов" Margin="20,0,26,0" VerticalAlignment="Center"
                           FontFamily="{StaticResource HeadFont}" FontSize="18" FontWeight="Bold" Foreground="White"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch">
                    <RadioButton x:Name="navAfisha" GroupName="MainNav" Content="Афиша" Style="{StaticResource NavTabStyle}"
                                 IsChecked="True" Checked="navAfisha_Checked"/>
                    <RadioButton x:Name="navKalendar" GroupName="MainNav" Content="Календарь" Style="{StaticResource NavTabStyle}"
                                 Checked="navKalendar_Checked"/>
                    <RadioButton x:Name="navZakazy" GroupName="MainNav" Content="Мои заказы" Style="{StaticResource NavTabStyle}"
                                 Checked="navZakazy_Checked"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Button x:Name="btnAdmin" Content="Панель администратора" Style="{StaticResource LinkButton}"
                            Foreground="White" Margin="0,0,12,0" Click="btnAdmin_Click" Visibility="Collapsed"/>
                    <Button x:Name="btnCashier" Content="Рабочее место кассира" Style="{StaticResource LinkButton}"
                            Foreground="White" Margin="0,0,12,0" Click="btnCashier_Click" Visibility="Collapsed"/>
                    <Border Background="#2E417F" CornerRadius="3" Padding="8,3" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock x:Name="tbRole" Text="" FontSize="12" Foreground="White"/>
                    </Border>
                    <TextBlock x:Name="tbUser" Text="" FontSize="13" Foreground="White" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button x:Name="btnExit" Content="Выйти" Style="{StaticResource LinkButton}" Foreground="White" Click="btnExit_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <ContentControl x:Name="pageHost" Margin="0"/>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource BlockBrush}" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="20,6">
                <TextBlock x:Name="tbStatus" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="tbClock" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                           HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}"/>
            </Grid>
        </Border>
    </Grid>
</Window>