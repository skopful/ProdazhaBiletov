<UserControl x:Class="ProdazhaBiletov.CashierProdazhaPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20,16,20,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Продажа билетов" Style="{StaticResource PageTitle}"/>
            <TextBlock x:Name="tbCount" Style="{StaticResource CaptionText}" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="tbSearch" Style="{StaticResource FieldBox}" Width="280" Margin="0,0,12,0"
                         ToolTip="Поиск по названию мероприятия или площадке" TextChanged="tbSearch_TextChanged"/>
                <DatePicker x:Name="dpFrom" Style="{StaticResource DateField}" Width="150" SelectedDateChanged="FilterChanged"/>
                <TextBlock Text="–" Margin="8,0" VerticalAlignment="Center"/>
                <DatePicker x:Name="dpTo" Style="{StaticResource DateField}" Width="150" SelectedDateChanged="FilterChanged"/>
                <Button Content="Сбросить" Style="{StaticResource LinkButton}" Margin="14,0,0,0" Click="btnReset_Click"/>
                <Button Content="Обновить" Style="{StaticResource LinkButton}" Margin="6,0,0,0" Click="btnRefresh_Click"/>
            </StackPanel>
        </Border>

        <DataGrid x:Name="dgEvents" Grid.Row="2" Style="{StaticResource DataTableStyle}"
                  ColumnHeaderStyle="{StaticResource TableHeaderStyle}" MouseDoubleClick="dgEvents_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата и время" Binding="{Binding DataVremyaNachala, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="145"
                                    ElementStyle="{StaticResource MonoText}"/>
                <DataGridTextColumn Header="Мероприятие" Binding="{Binding Nazvanie}" Width="2*"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding NazvanieTipa}" Width="120"/>
                <DataGridTextColumn Header="Площадка" Binding="{Binding NazvaniePloshchadki}" Width="1.4*"/>
                <DataGridTextColumn Header="Зал" Binding="{Binding NazvanieZala}" Width="130"/>
                <DataGridTextColumn Header="Свободно" Binding="{Binding SvobodnoMest}" Width="90" ElementStyle="{StaticResource MonoText}"/>
                <DataGridTextColumn Header="Цена от" Binding="{Binding MinCena, StringFormat={}{0:N0} ₽}" Width="100"
                                    ElementStyle="{StaticResource MonoText}"/>
                <DataGridTemplateColumn Header="Действия" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Продать билеты" Style="{StaticResource LinkButton}" Tag="{Binding}" Click="btnSell_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>