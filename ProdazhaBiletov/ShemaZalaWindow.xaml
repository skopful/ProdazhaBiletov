<Window x:Class="ProdazhaBiletov.ShemaZalaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Схема зала" Height="720" Width="1200" MinHeight="620" MinWidth="1050"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource PageBrush}" FontFamily="{StaticResource BaseFont}">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Схема зала" Style="{StaticResource PageTitle}"/>
                    <TextBlock x:Name="tbZal" Style="{StaticResource CaptionText}" Margin="0,2,0,16"/>

                    <TextBlock Text="Число рядов *" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="tbRyady" Text="10" Style="{StaticResource FieldBox}" Margin="0,0,0,12"
                             TextChanged="tbRyady_TextChanged"/>

                    <TextBlock Text="Мест в ряду *" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="tbMesta" Text="20" Style="{StaticResource FieldBox}" Margin="0,0,0,4"
                             TextChanged="tbMesta_TextChanged"/>
                    <TextBlock x:Name="tbItog" Style="{StaticResource CaptionText}" Margin="0,0,0,12"/>

                    <TextBlock Text="Категории мест по рядам" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,6"
                               Text="Ряды делятся поровну между выбранными категориями. Цена берётся из справочника цен мероприятия."/>

                    <ItemsControl x:Name="panelKategorii" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Style="{StaticResource CheckBoxFont}" Content="{Binding NazvanieKategorii}"
                                          Tag="{Binding Id}" IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource Card}" Background="{StaticResource PageBrush}" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock x:Name="tbInfo" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Button Content="Создать схему" Style="{StaticResource AccentButton}" Click="btnGenerate_Click" Margin="0,0,0,8"/>
                    <Button Content="Закрыть" Style="{StaticResource GhostButton}" Click="btnClose_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ContentControl x:Name="preview"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="Удалить все места зала" Style="{StaticResource GhostButton}"
                            Margin="0,0,8,0" Click="btnClear_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>