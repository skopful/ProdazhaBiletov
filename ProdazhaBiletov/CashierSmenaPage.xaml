<UserControl x:Class="ProdazhaBiletov.CashierSmenaPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20,16,20,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Моя смена" Style="{StaticResource PageTitle}"/>
                <TextBlock x:Name="tbDate" Style="{StaticResource CaptionText}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Content="Обновить" Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Click="btnRefresh_Click"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16">
                <StackPanel>
                    <TextBlock Text="Заказов за смену" Style="{StaticResource CaptionText}"/>
                    <TextBlock x:Name="tbOrders" Text="0" FontSize="26" FontWeight="Bold"
                               FontFamily="{StaticResource HeadFont}" Foreground="{StaticResource MainBrush}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
                <StackPanel>
                    <TextBlock Text="Продано билетов" Style="{StaticResource CaptionText}"/>
                    <TextBlock x:Name="tbTickets" Text="0" FontSize="26" FontWeight="Bold"
                               FontFamily="{StaticResource HeadFont}" Foreground="{StaticResource MainBrush}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="16">
                <StackPanel>
                    <TextBlock Text="Выручка" Style="{StaticResource CaptionText}"/>
                    <TextBlock x:Name="tbRevenue" Text="0 ₽" FontSize="26" FontWeight="Bold"
                               FontFamily="{StaticResource HeadFont}" Foreground="{StaticResource MainBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <DataGrid x:Name="dgSmena" Grid.Row="2" Style="{StaticResource DataTableStyle}"
                  ColumnHeaderStyle="{StaticResource TableHeaderStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Номер" Binding="{Binding NomerZakaza}" Width="130" ElementStyle="{StaticResource MonoText}"/>
                <DataGridTextColumn Header="Время" Binding="{Binding DataZakaza, StringFormat={}{0:HH:mm}}" Width="80"
                                    ElementStyle="{StaticResource MonoText}"/>
                <DataGridTextColumn Header="Мероприятие" Binding="{Binding Meropriyatie}" Width="2*"/>
                <DataGridTextColumn Header="Билетов" Binding="{Binding Kolichestvo}" Width="80"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding SummaZakaza, StringFormat={}{0:N0} ₽}" Width="110"
                                    ElementStyle="{StaticResource MonoText}"/>
                <DataGridTextColumn Header="Оплата" Binding="{Binding SposobOplaty}" Width="150"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding StatusZakaza}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>