<UserControl x:Class="ProdazhaBiletov.AdminZalyPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20,16,20,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="Залы" Style="{StaticResource PageTitle}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Добавить зал" Style="{StaticResource AccentButton}" Width="150"
                            Click="btnAddZal_Click"/>
                </StackPanel>
            </Grid>

            <DataGrid x:Name="dgZaly" Grid.Row="1" Style="{StaticResource DataTableStyle}" ColumnHeaderStyle="{StaticResource TableHeaderStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding idZala}" Width="45" ElementStyle="{StaticResource MonoText}"/>
                    <DataGridTextColumn Header="Название" Binding="{Binding NazvanieZala}" Width="*"/>
                    <DataGridTextColumn Header="Вместимость" Binding="{Binding Vmestimost}" Width="100" ElementStyle="{StaticResource MonoText}"/>
                    <DataGridTextColumn Header="Мест" Binding="{Binding KolMest}" Width="70" ElementStyle="{StaticResource MonoText}"/>
                    <DataGridTemplateColumn Header="Схема" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding EstSkhemaMest, Mode=OneWay}" IsEnabled="False" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="" Width="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Схема" Style="{StaticResource LinkButton}" Tag="{Binding}" Click="btnShema_Click" Margin="0,0,10,0"/>
                                    <Button Content="Удал." Style="{StaticResource LinkButton}" Tag="{Binding}" Click="btnDelZal_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
            <StackPanel>
                <TextBlock Text="Площадки" Style="{StaticResource PageTitle}" Margin="0,0,0,12"/>
                <DataGrid x:Name="dgPloshchadki" Style="{StaticResource DataTableStyle}" ColumnHeaderStyle="{StaticResource TableHeaderStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding idPloshchadki}" Width="45" ElementStyle="{StaticResource MonoText}"/>
                        <DataGridTextColumn Header="Название" Binding="{Binding NazvaniePloshchadki}" Width="*"/>
                        <DataGridTextColumn Header="Город" Binding="{Binding NazvanieGoroda}" Width="120"/>
                        <DataGridTextColumn Header="Адрес" Binding="{Binding Adres}" Width="2*"/>
                        <DataGridTextColumn Header="Залов" Binding="{Binding KolZalov}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>